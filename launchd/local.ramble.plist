<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.ramble</string>
  <key>ProgramArguments</key>
  <array><string>@APP@/Contents/MacOS/Ramble</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@HOME@/.ramble/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.ramble/logs/launchd.log</string>
</dict>
</plist>
