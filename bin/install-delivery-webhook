#!/usr/bin/env python3
"""Install just the opt-in delivery webhook, preserving capture and its settings."""
import os
import plistlib
import subprocess
from pathlib import Path

repo = Path(__file__).resolve().parent.parent
python = repo / ".venv/bin/python"
home = Path(os.environ.get("RAMBLE_HOME", Path.home() / ".ramble")).expanduser().resolve()
home.mkdir(parents=True, exist_ok=True)
(home / "logs").mkdir(exist_ok=True)
env = dict(os.environ, RAMBLE_HOME=str(home))
subprocess.run([str(python), "-m", "ramble.delivery_webhook", "--init"],
               cwd=repo, env=env, check=True)
plist = Path.home() / "Library/LaunchAgents/local.ramble.delivery-webhook.plist"
plist.parent.mkdir(parents=True, exist_ok=True)
with plist.open("wb") as stream:
    plistlib.dump({
        "Label": "local.ramble.delivery-webhook",
        "ProgramArguments": [str(python), "-m", "ramble.delivery_webhook"],
        "WorkingDirectory": str(repo),
        "EnvironmentVariables": {"RAMBLE_HOME": str(home)},
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 10,
        "Umask": 0o077,
        "StandardOutPath": str(home / "logs/delivery-webhook.log"),
        "StandardErrorPath": str(home / "logs/delivery-webhook.log"),
    }, stream)
target = f"gui/{os.getuid()}"
subprocess.run(["launchctl", "bootout", target + "/local.ramble.delivery-webhook"],
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
subprocess.run(["launchctl", "bootstrap", target, str(plist)], check=True)
print("Delivery webhook installed on 127.0.0.1:8789; token was not printed.")
